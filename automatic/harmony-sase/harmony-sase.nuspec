<?xml version="1.0" encoding="utf-8"?>
<!-- Do not remove this test for UTF-8: if “Ω” doesn’t appear as greek uppercase omega letter enclosed in quotation marks, you should use an editor that supports UTF-8, not this one. -->
<package xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <metadata>
    <id>harmony-sase</id>
    <title>Harmony SASE</title>
    <version>12.10.0.16341</version>
    <authors>Check Point</authors>
    <owners>chocolatey-community</owners>
    <summary>Harmony SASE client to connect to networks managed by Harmony SASE / Perimeter 81</summary>
    <description><![CDATA[Harmony SASE has been rebranded to Checkpoint SASE.

This package no longer contains the installer. Instead, it pulls in the [`checkpoint-sase`](https://chocolatey.org/packages/checkpoint-sase) package so you always receive the official Checkpoint SASE build from Check Point.
]]></description>
    <projectUrl>https://sase.checkpoint.com/</projectUrl>
    <packageSourceUrl>https://github.com/BlythMeister/chocolatey-packages/tree/master/automatic/harmony-sase</packageSourceUrl>
    <tags>harmony-sase networking</tags>
    <licenseUrl>https://support.perimeter81.com/docs/open-source-software-licenses-and-notices</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <iconUrl>https://raw.githubusercontent.com/BlythMeister/chocolatey-packages/master/icons/harmony-sase.png</iconUrl>
    <docsUrl>https://support.perimeter81.com/docs/</docsUrl>
    <releaseNotes>https://support.perimeter81.com/docs/windows-agent-release-notes</releaseNotes>
    <dependencies>
      <dependency id="checkpoint-sase" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
